# Biến môi trường cho docker compose (bước 13). Copy thành .env rồi đổi giá trị — .env KHÔNG commit.

# Mật khẩu user "ielts" của PostgreSQL trong container (không liên quan PostgreSQL cài trên máy).
DB_PASSWORD=doi-mat-khau-db

# Khoá ký JWT: chuỗi ngẫu nhiên dài ít nhất 32 ký tự, vd sinh bằng: openssl rand -base64 48
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# Mật khẩu tài khoản admin được tạo ở lần chạy đầu (tên đăng nhập: admin).
ADMIN_PASSWORD=Doi@Matkhau2026

# Địa chỉ người dùng truy cập (dùng cho link trong email, CORS, WebSocket).
PUBLIC_URL=https://localhost
PUBLIC_WS_URL=wss://localhost/ws

# Dữ liệu mẫu cho buổi demo (bước 20): đổi thành docker,demo để có sẵn giáo viên gv.demo, lớp DEMO-A / DEMO-B,
# 20 sinh viên DEMO001…DEMO020 (cùng mật khẩu DEMO_PASSWORD, không bắt đổi). Chỉ dùng cho demo / kiểm thử.
SPRING_PROFILES_ACTIVE=docker
DEMO_PASSWORD=Demo@2026
# Số sinh viên lớp kiểm thử tải DEMO-LOAD (bước 14); loadtest/compose.loadtest.yml tự đặt 500.
DEMO_LOAD_STUDENTS=0

# Tuỳ chọn: bật gợi ý chấm bằng AI (Mức 3).
ANTHROPIC_API_KEY=
